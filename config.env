# KernelSU Action -- build profile
CONFIG_ENV=config.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://android.googlesource.com/kernel/common
KERNEL_SOURCE_BRANCH=android13-5.15
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image.lz4
ARCH=arm64
KERNEL_NAME=

ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379
USE_CUSTOM_CLANG=false
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ==
KSU_VARIANT=sukisu-ultra
KSU_REF=main
KSU_HOOK_MODE=auto

# =================================================================== SUSFS ==
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ==
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ==
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=CONFIG_KSU_DEBUG=n

# ============================================================= AnyKernel3 ==
USE_CUSTOM_ANYKERNEL3=false
BUILD_BOOT_IMG=false

# ================================================================= Runner ==
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
